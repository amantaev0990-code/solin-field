@inject HttpClient Http
@inject IJSRuntime JS

<div class="shell">
  <button disabled="@busy" @onclick="Export">@(busy ? "Создаю MDB…" : "Экспорт")</button>
  @if (!string.IsNullOrEmpty(status))
  {
    <p role="status" class="status">@status</p>
  }
</div>

@code {
  private bool busy;
  private string status = "";

  protected override async Task OnAfterRenderAsync(bool firstRender)
  {
    if (firstRender && await JS.InvokeAsync<bool>("solinShouldAutoExport"))
      await Export();
  }

  private async Task Export()
  {
    if (busy) return;
    busy = true;
    try
    {
      status = "Готовлю карточки выбранного лесничества…";
      await InvokeAsync(StateHasChanged);
      string snapshot = await JS.InvokeAsync<string>("solinGetTransferJson");
      status = "Создаю файл MDB…";
      await InvokeAsync(StateHasChanged);
      byte[] template = await Http.GetByteArrayAsync("blank-transfer.mdb");
      TransferConverter.Result result = TransferConverter.ConvertFromSnapshot(snapshot, template);
      await JS.InvokeVoidAsync("saveMdb", result.FileName, result.Bytes);
      status = "Файл " + result.FileName +
        " готов. Если он не скачался автоматически, нажмите «Сохранить MDB».";
    }
    catch (Exception error)
    {
      status = "Экспорт остановлен: " + error.Message +
        ". Рабочие карточки не изменены.";
      // The writer may run inside an off-screen same-origin frame. Report
      // failures to the visible SOLI-N Field page instead of hiding them.
      try { await JS.InvokeVoidAsync("solinReportMdbError", error.Message); }
      catch { /* The standalone diagnostic page can still show status. */ }
    }
    finally
    {
      busy = false;
      await InvokeAsync(StateHasChanged);
    }
  }
}
